> ### Name: lmm_animal
> ### Title: Fit linear mixed animal model
> ### Aliases: lmm_animal
> 
> ### ** Examples
> 
> ## Not run: 
> ##D set.seed(1)
> ##D n <- 40
> ##D ped <- data.frame(
> ##D   id = 1:n,
> ##D   sire = c(rep(NA, 20), sample(1:10, 20, replace = TRUE)),
> ##D   dam = c(rep(NA, 20), sample(11:20, 20, replace = TRUE))
> ##D )
> ##D A <- makeA(ped)
> ##D X <- cbind(Intercept = 1, sex = rbinom(n, 1, 0.5))
> ##D G <- random_covariance(2, min_var = 0.8, max_var = 1.2,
> ##D                        trait_names = c("t1", "t2"))
> ##D E <- random_covariance(2, min_var = 0.8, max_var = 1.2,
> ##D                        trait_names = c("t1", "t2"))
> ##D Y <- X %*% rbind(c(10, 9), c(1, -0.5)) +
> ##D   t(chol(A)) %*% matrix(rnorm(n * 2), n) %*% chol(G) +
> ##D   matrix(rnorm(n * 2), n) %*% chol(E)
> ##D colnames(Y) <- c("t1", "t2")
> ##D 
> ##D fit <- lmm_animal(Y, X, A, iter = 1000, warmup = 500,
> ##D                   chains = 2, cores = 2, refresh = 0)
> ##D fit$summary(c("G", "E", "h2"))
> ##D round(draws_mean(fit, "G"), 2)
> ##D 
> ##D # Univariate model with the h2 parametrization
> ##D fit_h2 <- lmm_animal(Y[, 1], X, A, parametrization = "h2",
> ##D                      iter = 1000, warmup = 500,
> ##D                      chains = 2, cores = 2)
> ##D 
> ##D # Sparse factor G
> ##D factor_fit <- lmm_animal(Y, X, A, genetic_structure = "factor",
> ##D                          n_factors = 1, iter = 1000, warmup = 500,
> ##D                          chains = 2, cores = 2)
> ##D factor_fit$summary(c("loadings", "factor_magnitude"))
> ##D dim(fit_draws(factor_fit)$loadings)
> ##D 
> ##D # Shared factors for G and E
> ##D shared_fit <- lmm_animal(Y, X, A, genetic_structure = "factor",
> ##D                          residual_structure = "shared_factor",
> ##D                          n_factors = 1, iter = 1000, warmup = 500,
> ##D                          chains = 2, cores = 2)
> ##D shared_fit$summary(c("factor_heritability", "genetic_uniqueness"))
> ## End(Not run)
> 
