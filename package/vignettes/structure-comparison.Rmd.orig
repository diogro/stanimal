title: "Comparing covariance structures"
output: rmarkdown::html_vignette
vignette: >
  %\VignetteIndexEntry{Comparing covariance structures}
  %\VignetteEngine{knitr::rmarkdown}
  %\VignetteEncoding{UTF-8}
