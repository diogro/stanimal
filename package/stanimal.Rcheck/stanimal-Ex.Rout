> pkgname <- "stanimal"
> source(file.path(R.home("share"), "R", "examples-header.R"))
> options(warn = 1)
> library('stanimal')
> 
> base::assign(".oldSearch", base::search(), pos = 'CheckExEnv')
> base::assign(".old_wd", base::getwd(), pos = 'CheckExEnv')
> cleanEx()
> nameEx("animal_design")
> ### * animal_design
> 
> flush(stderr()); flush(stdout())
> 
> ### Name: animal_design
> ### Title: Response and design matrices from a model formula
> ### Aliases: animal_design
> 
> ### ** Examples
> 
> dat <- data.frame(trait = rnorm(6), x = rnorm(6),
+                   sex = rep(c(0, 1), each = 3), id = 1:6)
> rownames(dat) <- dat$id
> design <- animal_design(trait ~ sex + x, dat)
> design$Y
       trait
1 -0.6264538
2  0.1836433
3 -0.8356286
4  1.5952808
5  0.3295078
6 -0.8204684
> design$X
  (Intercept) sex          x
1           1   0  0.4874291
2           1   0  0.7383247
3           1   0  0.5757814
4           1   1 -0.3053884
5           1   1  1.5117812
6           1   1  0.3898432
attr(,"assign")
[1] 0 1 2
> 
> # formulas written for lme4 work as they are; the random term is ignored
> animal_design(trait ~ sex + (1 | id), dat)
$Y
       trait
1 -0.6264538
2  0.1836433
3 -0.8356286
4  1.5952808
5  0.3295078
6 -0.8204684

$X
  (Intercept) sex
1           1   0
2           1   0
3           1   0
4           1   1
5           1   1
6           1   1
attr(,"assign")
[1] 0 1

attr(,"individuals")
[1] "1" "2" "3" "4" "5" "6"
> 
> # relatedness from a pedigree (first three columns: id, sire, dam)
> ped <- data.frame(id = 1:6, sire = c(0, 0, 1, 1, 4, 4),
+                   dam = c(0, 0, 2, 2, 3, 5))
> design <- animal_design(trait ~ sex, dat, pedigree = ped)
> round(design$A, 2)
    1   2    3    4    5    6
1 1.0 0.0 0.50 0.50 0.50 0.50
2 0.0 1.0 0.50 0.50 0.50 0.50
3 0.5 0.5 1.00 0.50 0.75 0.62
4 0.5 0.5 0.50 1.00 0.75 0.88
5 0.5 0.5 0.75 0.75 1.25 1.00
6 0.5 0.5 0.62 0.88 1.00 1.38
> 
> # related founders: pass their relationship matrix as Gamma
> Gamma <- matrix(c(1, 0.5, 0.5, 1), 2,
+                 dimnames = list(c("1", "2"), c("1", "2")))
> design <- animal_design(trait ~ sex, dat, pedigree = ped, Gamma = Gamma)
> round(design$A, 2)
     1    2    3    4    5    6
1 1.00 0.50 0.75 0.75 0.75 0.75
2 0.50 1.00 0.75 0.75 0.75 0.75
3 0.75 0.75 1.25 0.75 1.00 0.88
4 0.75 0.75 0.75 1.25 1.00 1.12
5 0.75 0.75 1.00 1.00 1.38 1.19
6 0.75 0.75 0.88 1.12 1.19 1.50
> 
> # relatedness from genotypes (individuals in rows, markers in columns)
> M <- matrix(rbinom(6 * 40, 2, 0.3), 6,
+             dimnames = list(as.character(1:6), NULL))
> design <- animal_design(trait ~ sex, dat, genotypes = M, blend = 0.01)
> dim(design$A)
[1] 6 6
> 
> 
> 
> cleanEx()
> nameEx("back_transform")
> ### * back_transform
> 
> flush(stderr()); flush(stdout())
> 
> ### Name: back_transform
> ### Title: Back-transform posterior draws to the original trait scale
> ### Aliases: back_transform
> 
> ### ** Examples
> 
> ss <- size_shape(cbind(a = rnorm(20), b = rnorm(20), c = rnorm(20)))
> k <- length(ss$raw_traits)
> names_mat <- function(var) sprintf(paste0(var, "[%d,%d]"),
+                                    rep(seq_len(k), k), rep(seq_len(k), each = k))
> # a real fit supplies G and E; here the same draw is repeated
> G <- random_covariance(k, min_var = 0.5, max_var = 1.5)
> E <- random_covariance(k, min_var = 0.5, max_var = 1.5)
> m <- cbind(matrix(rep(as.vector(G), 4), 4, byrow = TRUE),
+            matrix(rep(as.vector(E), 4), 4, byrow = TRUE))
> colnames(m) <- c(names_mat("G"), names_mat("E"))
> post <- back_transform(m, ss)
> dim(post$G)                    # traits x traits x draws
[1] 3 3 4
> draws_mean(post, "G")          # posterior mean G on the trait scale
          a        b         c
a 1.3271351 1.500825 0.7462116
b 1.5008251 3.087045 1.2385075
c 0.7462116 1.238508 2.0412791
> draws_mean(post, "h2")
        a         b         c 
0.5038490 0.4850130 0.8520711 
> 
> 
> 
> cleanEx()
> nameEx("breeding_values")
> ### * breeding_values
> 
> flush(stderr()); flush(stdout())
> 
> ### Name: breeding_values
> ### Title: Estimated breeding values (BLUPs)
> ### Aliases: breeding_values print.stanimal_breeding_values
> 
> ### ** Examples
> 
> ## Not run: 
> ##D fit <- lmm_animal(Y, X, A, iter = 1000, warmup = 500,
> ##D                   chains = 2, cores = 2, refresh = 0)
> ##D ebv <- breeding_values(fit)
> ##D ebv                                   # first individuals, with reliability
> ##D head(ebv$values)                      # individuals x traits
> ##D range(ebv$reliability)
> ##D 
> ##D # The predicted values are on the trait's scale, so they can be ranked
> ##D order(ebv$values[, 1], decreasing = TRUE)[1:5]
> ## End(Not run)
> 
> 
> 
