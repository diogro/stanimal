> ### Name: lm_phen_cov
> ### Title: Fit a Bayesian phenotypic covariance matrix
> ### Aliases: lm_phen_cov
> 
> ### ** Examples
> 
> ## Not run: 
> ##D set.seed(1)
> ##D n <- 60
> ##D X <- cbind(Intercept = 1, sex = rbinom(n, 1, 0.5))
> ##D P <- random_covariance(3, min_var = 0.8, max_var = 1.2,
> ##D                        trait_names = c("t1", "t2", "t3"))
> ##D B <- rbind(c(10, 9, 11), c(1, -0.5, 0.3))
> ##D Y <- X %*% B + matrix(rnorm(n * 3), n) %*% chol(P)
> ##D colnames(Y) <- c("t1", "t2", "t3")
> ##D 
> ##D fit <- lm_phen_cov(Y, X, iter = 1000, warmup = 500,
> ##D                    chains = 2, cores = 2, refresh = 0)
> ##D fit$summary(c("P", "corrP", "sigma_P"))
> ##D round(draws_mean(fit, "P"), 2)
> ##D 
> ##D # Sparse factor P
> ##D factor_fit <- lm_phen_cov(Y, X, covariance_structure = "factor",
> ##D                           n_factors = 2, iter = 1000, warmup = 500,
> ##D                           chains = 2, cores = 2, refresh = 0)
> ##D factor_fit$summary(c("P", "loadings", "factor_magnitude"))
> ##D dim(fit_draws(factor_fit)$loadings)
> ## End(Not run)
> 
> 
