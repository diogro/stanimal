^\.Rproj\.user$
\.Rcheck$
^.*\.tar\.gz$
^data-raw$
Rplots\.pdf$
# rstan writes the compiled model next to its .stan source; the executables are
# build artifacts and must not reach the tarball (R CMD check flags them).
^inst/stan/animalModelG$
^inst/stan/animalModelGFactor$
^inst/stan/.*\.(o|hpp|rds)$
# Vignette sources: the shipped .Rmd files are precomputed from them
^vignettes/.*\.Rmd\.orig$
^vignettes/precompute\.R$
# pkgdown site configuration (the site itself is built into ../docs)
^_pkgdown\.yml$
^pkgdown$
